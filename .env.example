# eWeLink CUBE — independent config (no shared code with dashboard)
CUBE_BASE_URL=https://<your-cube-id>.cube.ewelink.cc
CUBE_ACCESS_TOKEN=
CUBE_APP_NAME=ewelink-mcp

MCP_PORT=3001
# Optional: require Authorization: Bearer <key> on /mcp. Leave blank for LAN-only use.
MCP_API_KEY=

# Local history DB file for THIS server only (separate from dashboard history.db)
HISTORY_DB_PATH=./mcp-history.db
# Auto-record sensor snapshots from live SSE cache every N ms (0 = disabled)
HISTORY_AUTO_RECORD_MS=300000
